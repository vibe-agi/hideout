{
  "schemaVersion": "hideout.host-app-pack/v1",
  "id": "test.external-vscode",
  "version": "1.0.0",
  "description": "Gate 2 external recipe binding hcode to the installed VS Code application",
  "apps": [
    {
      "id": "vscode",
      "platforms": [
        "darwin"
      ],
      "bundleNames": [
        "Visual Studio Code.app"
      ],
      "executableRelativePath": "Contents/MacOS/Code",
      "expectedBundleId": "com.microsoft.VSCode",
      "expectedTeamId": "UBF8T346G9",
      "requestedSafetyProfile": "vscode-family-v1",
      "launch": {
        "gotoFlag": "--goto",
        "newWindowFlag": "--new-window",
        "reuseWindowFlag": "--reuse-window",
        "gotoSeparator": ":"
      }
    }
  ],
  "bindings": [
    {
      "id": "hcode-command",
      "commands": [
        "hcode"
      ],
      "appId": "vscode",
      "capabilityId": "host.app.open-resource",
      "resourceKinds": [
        "workspace",
        "hostfs-portal"
      ],
      "resultPolicy": "none",
      "requestedAccess": "safe",
      "grammar": {
        "kind": "open-resource-v1",
        "resourceCount": 1,
        "gotoFlags": [
          "-g",
          "--goto"
        ],
        "newWindowFlags": [
          "-n",
          "--new-window"
        ],
        "reuseWindowFlags": [
          "-r",
          "--reuse-window"
        ],
        "unknownFlags": "deny"
      }
    }
  ],
  "tests": [
    {
      "id": "workspace-file",
      "bindingId": "hcode-command",
      "argv": [
        "hcode",
        "src/main.go"
      ],
      "expected": {
        "resource": "/workspace/src/main.go",
        "windowMode": "reuse"
      }
    },
    {
      "id": "goto-location",
      "bindingId": "hcode-command",
      "argv": [
        "hcode",
        "-g",
        "src/main.go:12:3"
      ],
      "expected": {
        "resource": "/workspace/src/main.go",
        "line": 12,
        "column": 3,
        "windowMode": "reuse"
      }
    }
  ]
}
