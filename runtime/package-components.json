{
  "schema": "hideout.package-components/v1",
  "components": [
    {
      "id": "linux-observer",
      "kind": "linux-helper",
      "artifactTemplate": "bin/hideout-observer-linux-{linuxGuestArch}",
      "manifestTemplate": "bin/hideout-observer-linux-{linuxGuestArch}.manifest.json",
      "license": "Apache-2.0",
      "sourceLicense": "Apache-2.0 OR GPL-2.0-only",
      "kernelProgramLicense": "GPL",
      "licenseText": "LICENSES/GPL-2.0-only.txt",
      "buildMode": "embedded-core-bpf",
      "packageOwned": true
    },
    {
      "id": "linux-migration-adopt",
      "kind": "linux-helper",
      "artifactTemplate": "bin/hideout-migration-adopt-linux-{linuxGuestArch}",
      "manifestTemplate": "bin/hideout-migration-adopt-linux-{linuxGuestArch}.manifest.json",
      "license": "Apache-2.0",
      "buildMode": "strict-data-only-adoption-v1",
      "packageOwned": true
    },
    {
      "id": "host-migration-vz-adopt",
      "kind": "host-helper",
      "artifactTemplate": "bin/hideout-migration-vz-adopt-{hostOS}-{hostArch}",
      "manifestTemplate": "bin/hideout-migration-vz-adopt-{hostOS}-{hostArch}.manifest.json",
      "license": "Apache-2.0",
      "buildMode": "apple-vz-zero-network-adoption-entitled-v1",
      "upstreamModule": "github.com/Code-Hex/vz/v3",
      "upstreamVersion": "v3.7.1",
      "packageOwned": true
    },
    {
      "id": "browser-console",
      "kind": "embedded-assets",
      "container": "bin/hideout",
      "manifest": "runtime/browser-console.assets.json",
      "license": "Apache-2.0",
      "packageOwned": true,
      "assets": [
        {
          "path": "index.html",
          "mediaType": "text/html; charset=utf-8"
        },
        {
          "path": "style.css",
          "mediaType": "text/css; charset=utf-8"
        },
        {
          "path": "state.js",
          "mediaType": "text/javascript; charset=utf-8"
        },
        {
          "path": "client.js",
          "mediaType": "text/javascript; charset=utf-8"
        },
        {
          "path": "activity.js",
          "mediaType": "text/javascript; charset=utf-8"
        },
        {
          "path": "config.js",
          "mediaType": "text/javascript; charset=utf-8"
        },
        {
          "path": "migration.js",
          "mediaType": "text/javascript; charset=utf-8"
        },
        {
          "path": "presentation.js",
          "mediaType": "text/javascript; charset=utf-8"
        },
        {
          "path": "app.js",
          "mediaType": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
