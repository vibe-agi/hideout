{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/runtime-verification.schema.json",
  "title": "Hideout Runtime Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environmentId",
    "imageRef",
    "provenance",
    "contractDigest",
    "observedAt",
    "sessionId",
    "backend",
    "backendReal",
    "running",
    "instance",
    "privilegeStatus",
    "status",
    "results",
    "failedIds"
  ],
  "properties": {
    "schema": {
      "const": "hideout.runtime-verification/v1"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1
    },
    "imageRef": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "contractDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "backend": {
      "const": "lima"
    },
    "backendReal": {
      "const": true
    },
    "running": {
      "const": true
    },
    "instance": {
      "$ref": "#/$defs/instance"
    },
    "privilegeStatus": {
      "enum": ["enforced", "degraded", "unknown"]
    },
    "status": {
      "enum": ["preview-ready", "preview-failed", "custom/unverified", "unknown"]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "failedIds": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "recoveryCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "vmType",
        "hostOS",
        "hostArch",
        "guestArch",
        "imageLocation",
        "imageSHA256",
        "activeBuildIdentity",
        "bootId"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "const": "Running" },
        "vmType": { "const": "vz" },
        "hostOS": { "const": "darwin" },
        "hostArch": { "const": "arm64" },
        "guestArch": { "const": "aarch64" },
        "imageLocation": { "type": "string", "format": "uri" },
        "imageSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "activeBuildIdentity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bootId": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "revision",
        "catalogRelease",
        "contractId",
        "contractDigest",
        "artifactLocation",
        "artifactSHA256",
        "packageInventoryDigest",
        "downloadBytes",
        "virtualBytes",
        "hostOS",
        "hostArch",
        "guestArch",
        "maturity"
      ],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "catalogRelease": {"type": "string", "minLength": 1},
        "contractId": {"type": "string", "minLength": 1},
        "contractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "artifactLocation": {"type": "string", "format": "uri"},
        "artifactSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "packageInventoryDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "downloadBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "virtualBytes": {"type": "integer", "minimum": 1, "maximum": 17179869184},
        "hostOS": {"type": "string", "minLength": 1},
        "hostArch": {"type": "string", "minLength": 1},
        "guestArch": {"type": "string", "minLength": 1},
        "maturity": {"const": "preview"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "command", "present", "matched", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "class": {"enum": ["boundary", "baseline"]},
        "command": {"type": "string", "minLength": 1, "maxLength": 128},
        "present": {"type": "boolean"},
        "versionOutput": {"type": "string", "maxLength": 512},
        "matched": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
