{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/formal-inventory.schema.json",
  "title": "Hideout formal verification inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tla2tools",
    "configurations",
    "goRefinement"
  ],
  "properties": {
    "schema": {
      "const": "hideout.formal-inventory/v1"
    },
    "tla2tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "url"
      ],
      "properties": {
        "version": {
          "const": "1.7.4"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/tlaplus/tlaplus/releases/"
        }
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "config",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]+$"
          },
          "module": {
            "type": "string",
            "pattern": "^formal/[A-Za-z][A-Za-z0-9]+\\.tla$"
          },
          "config": {
            "type": "string",
            "pattern": "^formal/(cfg/)?[A-Za-z][A-Za-z0-9]+\\.cfg$"
          },
          "kind": {
            "enum": [
              "safety",
              "safety-liveness"
            ]
          }
        }
      }
    },
    "goRefinement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages",
        "tests"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "importPath"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\./internal/[a-z0-9_/]+$"
              },
              "importPath": {
                "type": "string",
                "pattern": "^github\\.com/vibe-agi/hideout/internal/[a-z0-9_/]+$"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "name",
              "source",
              "classification"
            ],
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^github\\.com/vibe-agi/hideout/internal/[a-z0-9_/]+$"
              },
              "name": {
                "type": "string",
                "pattern": "^Test[A-Za-z0-9_]+$"
              },
              "source": {
                "type": "string",
                "pattern": "^internal/[a-z0-9_/]+_test\\.go$"
              },
              "classification": {
                "enum": [
                  "refinement",
                  "crash-matrix"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
