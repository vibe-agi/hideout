{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/helper-manifest.schema.json",
  "title": "Hideout Helper Manifest",
  "type": "object",
  "required": [
    "version",
    "command",
    "targetOS",
    "targetArch",
    "artifact",
    "sha256",
    "builder",
    "builtAt"
  ],
  "properties": {
    "version": {
      "const": "hideout.helper-manifest/v1"
    },
    "command": {
      "enum": [
        "hideout-shim",
        "hideout-hostfsd",
        "hideout-session-supervisor",
        "hideout-workspace-portal",
        "tun2socks"
      ]
    },
    "targetOS": {
      "const": "linux"
    },
    "targetArch": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder": {
      "type": "string",
      "minLength": 1
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "upstreamModule": {
      "type": "string",
      "minLength": 1
    },
    "upstreamVersion": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "buildMode": {
      "type": "string",
      "minLength": 1
    },
    "packageOwned": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
