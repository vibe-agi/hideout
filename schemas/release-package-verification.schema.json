{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/release-package-verification.schema.json",
  "title": "Hideout Release Package Verification Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observedAt", "status", "mode", "files", "package", "packageManifestSHA256"],
  "properties": {
    "schema": {"const": "hideout.release-package-verification/v1"},
    "observedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "passed"},
    "mode": {"const": "artifact"},
    "files": {"type": "integer", "minimum": 1},
    "package": {"$ref": "public-evidence-bundle.schema.json#/$defs/package"},
    "packageManifestSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
