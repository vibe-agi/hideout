{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/broker-envelope.schema.json",
  "title": "Hideout Broker Envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "oneOf": [
        {
          "$ref": "#/$defs/hostOpenRequest"
        },
        {
          "$ref": "#/$defs/commandAdapterRequest"
        },
        {
          "$ref": "#/$defs/hostFSRequest"
        }
      ]
    },
    "hostOpenRequest": {
      "type": "object",
      "required": [
        "id",
        "sessionId",
        "capabilityToken",
        "subject",
        "command",
        "argv",
        "route",
        "action",
        "args"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityToken": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "pattern": "^command:(open|xdg-open)$"
        },
        "command": {
          "enum": ["open", "xdg-open"]
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "route": {
          "const": "host-broker"
        },
        "action": {
          "const": "host.open"
        },
        "args": {
          "type": "object",
          "required": ["target"],
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "^/"
                },
                {
                  "not": {
                    "pattern": "^//"
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "subject": {
                "const": "command:open"
              }
            },
            "required": ["subject"]
          },
          "then": {
            "properties": {
              "command": {
                "const": "open"
              },
              "argv": {
                "prefixItems": [
                  {
                    "const": "open"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subject": {
                "const": "command:xdg-open"
              }
            },
            "required": ["subject"]
          },
          "then": {
            "properties": {
              "command": {
                "const": "xdg-open"
              },
              "argv": {
                "prefixItems": [
                  {
                    "const": "xdg-open"
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "commandAdapterRequest": {
      "type": "object",
      "required": [
        "id",
        "sessionId",
        "capabilityToken",
        "subject",
        "command",
        "argv",
        "route",
        "action",
        "args"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityToken": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "pattern": "^command:[^\\\\/\\s]+$"
        },
        "command": {
          "type": "string",
          "pattern": "^[^\\\\/\\s]+$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "route": {
          "const": "command-adapter"
        },
        "action": {
          "const": "command.adapter"
        },
        "args": {
          "type": "object",
          "required": [
            "cwd",
            "adapterId"
          ],
          "properties": {
            "cwd": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/"
            },
            "adapterId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hostFSRequest": {
      "type": "object",
      "required": [
        "id",
        "sessionId",
        "capabilityToken",
        "subject",
        "route",
        "action",
        "args"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityToken": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "const": "hostfs:daemon"
        },
        "route": {
          "const": "host-broker"
        },
        "action": {
          "enum": [
            "host.fs.stat",
            "host.fs.read",
            "host.fs.list",
            "host.fs.write",
            "host.fs.write.create",
            "host.fs.write.replace",
            "host.fs.write.append",
            "host.fs.write.truncate",
            "host.fs.write.mkdir",
            "host.fs.write.delete",
            "host.fs.write.rename",
            "host.fs.write.chmod",
            "host.fs.write.chown"
          ]
        },
        "args": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^//"
                  },
                  {
                    "pattern": "\\\\"
                  }
                ]
              }
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "destinationPath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/"
            },
            "dataBase64": {
              "type": "string"
            },
            "truncate": {
              "type": "boolean"
            },
            "mode": {
              "type": "string"
            },
            "uid": {
              "type": "integer"
            },
            "gid": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "not": {
                  "const": "host.fs.read"
                }
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "args": {
                "not": {
                  "anyOf": [
                    {
                      "required": ["offset"]
                    },
                    {
                      "required": ["size"]
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": ["command"]
          },
          {
            "required": ["argv"]
          }
        ]
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["id", "decision", "status", "exitCode"],
      "properties": {
        "id": {
          "type": "string"
        },
        "decision": {
          "enum": ["allow", "deny", "audit-only"]
        },
        "status": {
          "enum": ["ok", "denied", "error", "broker-unavailable", "bad-request", "simulated", "rewrite-guest", "proposal-unavailable"]
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "decision": {
                "const": "allow"
              },
              "exitCode": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "denied"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["stderr"],
            "properties": {
              "decision": {
                "const": "deny"
              },
              "exitCode": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "bad-request"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["stderr"],
            "properties": {
              "decision": {
                "const": "deny"
              },
              "exitCode": {
                "const": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "broker-unavailable"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["stderr"],
            "properties": {
              "decision": {
                "const": "deny"
              },
              "exitCode": {
                "const": 69
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["stderr"],
            "properties": {
              "decision": {
                "const": "deny"
              },
              "exitCode": {
                "const": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
