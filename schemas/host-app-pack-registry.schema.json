{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/host-app-pack-registry.schema.json",
  "title": "Hideout Host-App Pack Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updatedAt",
    "packs"
  ],
  "properties": {
    "schema": {
      "const": "hideout.host-app-pack-registry/v1"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/pack"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "localPath",
            "acquiredAt"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "localPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "acquiredAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url",
            "commit",
            "acquiredAt"
          ],
          "properties": {
            "kind": {
              "const": "git"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "acquiredAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "packId",
        "source",
        "sourceDigest",
        "manifestDigest",
        "basePermissionFingerprint",
        "validationStatus",
        "testStatus",
        "installedAt",
        "state"
      ],
      "properties": {
        "revisionId": {
          "$ref": "#/$defs/id"
        },
        "packId": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "basePermissionFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "validationStatus": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "testStatus": {
          "enum": [
            "not-run",
            "passed",
            "failed"
          ]
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "installed",
            "revoked"
          ]
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "revisions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "installed",
            "revoked",
            "removed"
          ]
        },
        "activeRevisionId": {
          "$ref": "#/$defs/id"
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/revision"
          }
        }
      }
    }
  }
}
