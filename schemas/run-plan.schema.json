{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/run-plan.schema.json",
  "title": "Hideout Run Plan",
  "type": "object",
  "required": [
    "version",
    "profile",
    "backend",
    "workspace",
    "guestWorkspace",
    "workspaceMode",
    "pathMode",
    "networkMode",
    "ephemeral",
    "command",
    "projectionCatalogDigest"
  ],
  "properties": {
    "version": {
      "const": "hideout.run-plan/v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": ["native", "lima"]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "guestWorkspace": {
      "type": "string",
      "minLength": 1
    },
    "workspaceMode": {
      "const": "read-write"
    },
    "pathMode": {
      "enum": ["preserve", "alias"]
    },
    "networkMode": {
      "enum": ["direct", "tun2socks"]
    },
    "proxySecretRef": {
      "type": "string",
      "minLength": 1
    },
    "ephemeral": {
      "type": "boolean"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "projectionCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
