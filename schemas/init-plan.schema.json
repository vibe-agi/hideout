{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/init-plan.schema.json",
  "title": "Hideout Init Plan",
  "type": "object",
  "required": ["version", "storeRoot", "profile", "backend", "network", "tasks", "nextSteps"],
  "properties": {
    "version": {
      "const": "hideout.init/v1"
    },
    "storeRoot": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": ["native", "lima"]
    },
    "network": {
      "enum": ["direct", "tun2socks"]
    },
    "proxySecretRef": {
      "type": "string"
    },
    "mediatedResolver": {
      "type": "string"
    },
    "templateId": {
      "enum": ["privacy", "hardened", "dev", "debug"]
    },
    "effectivePosture": {
      "enum": ["privacy", "hardened", "hardened-degraded", "dev", "debug-local"]
    },
    "privilegeStatus": {
      "enum": ["enforced", "degraded", "unknown"]
    },
    "privilegeReason": {
      "type": "string"
    },
    "privilegeGuidance": {
      "type": "string"
    },
    "privilegeSource": {
      "type": "string"
    },
    "allowDegradedTemplate": {
      "type": "boolean"
    },
    "evidencePath": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonClaims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewLines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hostfsVisibility": {
      "enum": ["none", "landmarks", "home-tree"]
    },
    "hostfsVisibilityRoots": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hostfsVisibilityRuleIds": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nameDisclosureAcknowledged": {
      "type": "boolean"
    },
    "runtimeSelection": {
      "$ref": "#/$defs/runtimeProvenance"
    },
    "imageRef": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nextStep"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "runtimeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "revision",
        "catalogRelease",
        "contractId",
        "contractDigest",
        "artifactLocation",
        "artifactSHA256",
        "downloadBytes",
        "virtualBytes",
        "hostOS",
        "hostArch",
        "guestArch",
        "maturity"
      ],
      "properties": {
        "family": {"type": "string", "minLength": 1, "maxLength": 64},
        "revision": {"type": "string", "minLength": 1, "maxLength": 64},
        "catalogRelease": {"type": "string", "minLength": 1, "maxLength": 64},
        "contractId": {"type": "string", "minLength": 1, "maxLength": 64},
        "contractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "artifactLocation": {"type": "string", "pattern": "^https://[^@\\s?#]+\\.qcow2$"},
        "artifactSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "downloadBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "virtualBytes": {"type": "integer", "minimum": 1, "maximum": 17179869184},
        "hostOS": {"enum": ["darwin", "linux"]},
        "hostArch": {"enum": ["arm64", "amd64"]},
        "guestArch": {"enum": ["aarch64", "x86_64"]},
        "maturity": {"const": "preview"}
      }
    },
    "nextStep": {
      "type": "object",
      "required": ["id", "label", "command", "message"],
      "properties": {
        "id": {
          "enum": ["doctor-check", "smoke-run", "cli-smoke", "resolve-blocked"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "status",
        "targetScope",
        "capabilityBoundary",
        "risk",
        "requiresConfirmation",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "store.create",
            "schema.metadata.write",
            "profile.create",
            "profile.environment.select",
            "identity.materialize",
            "network.mode.select",
            "backend.probe",
            "helper.install.linux-shim",
            "helper.install.linux-hostfsd",
            "helper.install.linux-session-supervisor",
            "doctor.check.light"
          ]
        },
        "source": {
          "enum": ["builtin", "doctor", "backend", "project", "bundle", "local-dev-override"]
        },
        "status": {
          "enum": ["ok", "pending", "applied", "blocked", "error"]
        },
        "targetScope": {
          "enum": ["machine", "profile", "project", "session"]
        },
        "capabilityBoundary": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "enum": ["safe", "requires-confirmation"]
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
