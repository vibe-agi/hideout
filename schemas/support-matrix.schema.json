{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/support-matrix.schema.json",
  "title": "Hideout Support Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generatedBy", "entries", "nonClaims"],
  "properties": {
    "schema": {
      "const": "hideout.support-matrix/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": {
      "const": "hideout"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "subject", "level", "reason", "guidance", "requiredGates", "evidence"],
        "properties": {
          "area": {
            "enum": ["platform", "backend", "feature", "release", "schema", "abi", "gate", "helper", "non-claim"]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": ["first-class", "supported", "degraded", "unsupported", "gate-required"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          },
          "requiredGates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "appliesTo", "guidance"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
