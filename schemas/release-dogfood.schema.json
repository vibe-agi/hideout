{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/release-dogfood.schema.json",
  "title": "Hideout Release Dogfood Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "exitCode",
    "startedAt",
    "endedAt",
    "command",
    "evidence",
    "git",
    "host",
    "tools",
    "operatorProxy",
    "browser",
    "gates",
    "cleanup",
    "isolationGates",
    "environmentSnapshot"
  ],
  "properties": {
    "schema": {
      "const": "hideout.release-dogfood.v1"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "enum": [
        "scripts/test-phase1.sh --release-candidate",
        "scripts/test-phase1.sh --isolation-evidence"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "log"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "log": {
          "const": "test-release-dogfood.log"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uname",
        "macOSProductVersion"
      ],
      "properties": {
        "uname": {
          "type": "string",
          "minLength": 1
        },
        "macOSProductVersion": {
          "type": "string"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go",
        "limactl",
        "jq"
      ],
      "properties": {
        "go": {
          "type": "string",
          "minLength": 1
        },
        "limactl": {
          "type": "string",
          "minLength": 1
        },
        "jq": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operatorProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided",
        "scheme",
        "url"
      ],
      "properties": {
        "provided": {
          "const": true
        },
        "scheme": {
          "enum": [
            "http",
            "https",
            "socks5",
            "socks5h",
            "unknown"
          ]
        },
        "url": {
          "const": "redacted"
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realBrowserRequired",
        "browserPathProvided",
        "browserApp"
      ],
      "properties": {
        "realBrowserRequired": {
          "const": true
        },
        "browserPathProvided": {
          "type": "boolean"
        },
        "browserApp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "releaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "bytes",
        "hideoutVersion"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^hideout-[A-Za-z0-9_.-]+\\.tar\\.gz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "hideoutVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "commit",
            "builtAt",
            "go",
            "platform"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "builtAt": {
              "type": "string",
              "minLength": 1
            },
            "go": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$"
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "gate0-static-contract"
          }
        },
        {
          "contains": {
            "const": "gate1-native-smoke"
          }
        },
        {
          "contains": {
            "const": "gate2-lima-e2e"
          }
        },
        {
          "contains": {
            "const": "gate3-hidden-proxy-operator"
          }
        },
        {
          "contains": {
            "const": "gate4-host-escape-real-browser"
          }
        },
        {
          "contains": {
            "const": "capability-probe-smoke"
          }
        },
        {
          "contains": {
            "const": "generic-cli-dogfood-smoke"
          }
        }
      ]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate4BrowserProcesses",
        "gate4TempDirs",
        "hideoutLimaInstances"
      ],
      "properties": {
        "gate4BrowserProcesses": {
          "type": "integer",
          "minimum": 0
        },
        "gate4TempDirs": {
          "type": "integer",
          "minimum": 0
        },
        "hideoutLimaInstances": {
          "type": "integer",
          "minimum": 0,
          "description": "Hideout Lima instances absent from the gate's startup snapshot but still present after cleanup."
        }
      }
    },
    "isolationGates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "backend",
          "result"
        ],
        "properties": {
          "id": {
            "enum": [
              "gate2-lima",
              "gate3-hidden-proxy",
              "gate4-host-escape",
              "env-image"
            ]
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "environmentName": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "reason": {
            "type": "string"
          },
          "auditPath": {
            "type": "string"
          },
          "boundarySummary": {
            "type": "string"
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema", "family", "revision", "artifactSHA256", "environmentId",
              "hostOS", "hostArch", "guestArch", "buildCommit", "buildDirty"
            ],
            "properties": {
              "schema": {"const": "hideout.runtime-evidence-binding/v1"},
              "family": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "artifactSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "environmentId": {"type": "string", "minLength": 1},
              "hostOS": {"type": "string", "minLength": 1},
              "hostArch": {"type": "string", "minLength": 1},
              "guestArch": {"type": "string", "minLength": 1},
              "buildCommit": {"type": "string", "minLength": 1},
              "buildDirty": {"type": "boolean"}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "not-run"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "backend": {
                  "not": {
                    "const": "native"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "environmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxyMode",
        "hostPrerequisites",
        "externalContext"
      ],
      "properties": {
        "proxyMode": {
          "enum": [
            "direct",
            "tun2socks"
          ]
        },
        "hostPrerequisites": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate4Browser",
            "envImageURL"
          ],
          "properties": {
            "gate4Browser": {
              "type": "boolean"
            },
            "envImageURL": {
              "type": "boolean"
            }
          }
        },
        "externalContext": {
          "type": "string"
        }
      }
    }
  }
}
