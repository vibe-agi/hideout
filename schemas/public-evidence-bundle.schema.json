{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/public-evidence-bundle.schema.json",
  "title": "Hideout Public Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceCommit", "package", "registrySchema", "proofIds", "files", "redactionStatus"],
  "properties": {
    "schema": {"const": "hideout.public-evidence-bundle/v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "package": {"$ref": "#/$defs/package"},
    "registrySchema": {"const": "hideout.proof-registry/v1"},
    "proofIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "redactionStatus": {"const": "passed"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "productVersion", "sourceCommit", "artifactSHA256", "hostOS", "hostArch"],
      "properties": {
        "name": {"const": "hideout"},
        "productVersion": {"type": "string", "minLength": 1},
        "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "artifactSHA256": {"$ref": "#/$defs/sha256"},
        "hostOS": {"const": "darwin"},
        "hostArch": {"const": "arm64"}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "sha256", "bytes", "redactionStatus", "exportDecision", "redactionStages"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]",
          "not": {"pattern": "(^|/)\\.\\.(/|$)"}
        },
        "kind": {"enum": ["manifest", "gate", "proof", "log", "docs-report"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "redactionStatus": {"const": "passed"},
        "exportDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "channel"],
          "properties": {
            "mode": {"const": "redact"},
            "channel": {"const": "flag"}
          }
        },
        "redactionStages": {
          "type": "array",
          "prefixItems": [
            {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "control-plane"}, "id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "entrypoint": {"type": "string"}}},
            {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"const": "user-data.local-path"}, "id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "entrypoint": {"type": "string"}}}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
