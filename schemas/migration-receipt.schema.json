{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/migration-receipt.schema.json",
  "title": "Hideout data-only migration adoption request and receipt v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{7,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "policy": {
      "enum": [
        "safe-clone",
        "exact-guest-restore"
      ]
    },
    "action": {
      "enum": [
        "reset-machine-id",
        "reset-ssh-host-keys",
        "preserve-guest-identity",
        "rebind-attached-disk-mounts",
        "install-destination-ssh-keys"
      ]
    },
    "diskMountBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diskId",
        "sourceGuestPath",
        "destinationGuestPath",
        "fsType"
      ],
      "properties": {
        "diskId": {
          "$ref": "#/$defs/opaqueId"
        },
        "sourceGuestPath": {
          "type": "string",
          "pattern": "^/mnt/lima-[A-Za-z0-9.-][A-Za-z0-9._-]{0,127}$"
        },
        "destinationGuestPath": {
          "type": "string",
          "pattern": "^/mnt/lima-[A-Za-z0-9.-][A-Za-z0-9._-]{0,127}$"
        },
        "fsType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$",
          "not": {
            "const": "swap"
          }
        }
      }
    },
    "mountBindings": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/diskMountBinding"
      }
    },
    "identityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineIdDigest",
        "sshHostKeyDigests"
      ],
      "properties": {
        "machineIdDigest": {
          "$ref": "#/$defs/digest"
        },
        "sshHostKeyDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "sha256"
      ],
      "properties": {
        "packageId": {
          "const": "hideout-migration-adopt"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "commonProperties": {
      "operationId": {
        "type": "string",
        "pattern": "^op_[A-Za-z0-9_-]{8,124}$"
      },
      "environmentRef": {
        "$ref": "#/$defs/opaqueId"
      },
      "requestNonce": {
        "type": "string",
        "pattern": "^nonce_[A-Za-z0-9_-]{8,121}$"
      },
      "receiptNonce": {
        "type": "string",
        "pattern": "^nonce_[A-Za-z0-9_-]{8,121}$"
      },
      "policy": {
        "$ref": "#/$defs/policy"
      },
      "helper": {
        "$ref": "#/$defs/helper"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operationId",
        "environmentRef",
        "requestNonce",
        "receiptNonce",
        "policy",
        "sourceIdentity",
        "destinationSSHUser",
        "destinationSSHKeys",
        "permittedActions",
        "helper"
      ],
      "properties": {
        "schema": {
          "const": "hideout.migration-adoption-request/v1"
        },
        "operationId": {
          "$ref": "#/$defs/commonProperties/operationId"
        },
        "environmentRef": {
          "$ref": "#/$defs/commonProperties/environmentRef"
        },
        "requestNonce": {
          "$ref": "#/$defs/commonProperties/requestNonce"
        },
        "receiptNonce": {
          "$ref": "#/$defs/commonProperties/receiptNonce"
        },
        "policy": {
          "$ref": "#/$defs/commonProperties/policy"
        },
        "sourceIdentity": {
          "$ref": "#/$defs/identityEvidence"
        },
        "destinationSSHUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
          "not": {
            "const": "root"
          }
        },
        "destinationSSHKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 8192,
            "pattern": "^(?:ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa) [A-Za-z0-9+/=]+(?: [^\\r\\n]{0,255})?$"
          }
        },
        "permittedActions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "mountBindings": {
          "$ref": "#/$defs/mountBindings"
        },
        "helper": {
          "$ref": "#/$defs/commonProperties/helper"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "safe-clone"
              }
            }
          },
          "then": {
            "properties": {
              "permittedActions": {
                "minItems": 3,
                "maxItems": 4,
                "allOf": [
                  {
                    "contains": {
                      "const": "reset-machine-id"
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "const": "reset-ssh-host-keys"
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "const": "install-destination-ssh-keys"
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mountBindings": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "mountBindings"
                  ]
                },
                "then": {
                  "properties": {
                    "permittedActions": {
                      "prefixItems": [
                        {
                          "const": "reset-machine-id"
                        },
                        {
                          "const": "reset-ssh-host-keys"
                        },
                        {
                          "const": "rebind-attached-disk-mounts"
                        },
                        {
                          "const": "install-destination-ssh-keys"
                        }
                      ],
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                },
                "else": {
                  "properties": {
                    "permittedActions": {
                      "prefixItems": [
                        {
                          "const": "reset-machine-id"
                        },
                        {
                          "const": "reset-ssh-host-keys"
                        },
                        {
                          "const": "install-destination-ssh-keys"
                        }
                      ],
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "permittedActions": {
                "minItems": 2,
                "maxItems": 3,
                "allOf": [
                  {
                    "contains": {
                      "const": "preserve-guest-identity"
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "const": "install-destination-ssh-keys"
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ],
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mountBindings": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "mountBindings"
                  ]
                },
                "then": {
                  "properties": {
                    "permittedActions": {
                      "prefixItems": [
                        {
                          "const": "preserve-guest-identity"
                        },
                        {
                          "const": "rebind-attached-disk-mounts"
                        },
                        {
                          "const": "install-destination-ssh-keys"
                        }
                      ],
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                },
                "else": {
                  "properties": {
                    "permittedActions": {
                      "prefixItems": [
                        {
                          "const": "preserve-guest-identity"
                        },
                        {
                          "const": "install-destination-ssh-keys"
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mountBindings": {
                "minItems": 1
              }
            },
            "required": [
              "mountBindings"
            ]
          },
          "then": {
            "properties": {
              "permittedActions": {
                "contains": {
                  "const": "rebind-attached-disk-mounts"
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "permittedActions": {
                "not": {
                  "contains": {
                    "const": "rebind-attached-disk-mounts"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^migration\\.[a-z0-9._-]{1,119}$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operationId",
        "environmentRef",
        "requestNonce",
        "receiptNonce",
        "policy",
        "helper",
        "actionResults",
        "status",
        "completionMarker"
      ],
      "properties": {
        "schema": {
          "const": "hideout.migration-adoption-receipt/v1"
        },
        "operationId": {
          "$ref": "#/$defs/commonProperties/operationId"
        },
        "environmentRef": {
          "$ref": "#/$defs/commonProperties/environmentRef"
        },
        "requestNonce": {
          "$ref": "#/$defs/commonProperties/requestNonce"
        },
        "receiptNonce": {
          "$ref": "#/$defs/commonProperties/receiptNonce"
        },
        "policy": {
          "$ref": "#/$defs/commonProperties/policy"
        },
        "helper": {
          "$ref": "#/$defs/commonProperties/helper"
        },
        "mountBindings": {
          "$ref": "#/$defs/mountBindings"
        },
        "actionResults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionResult"
          }
        },
        "postIdentity": {
          "$ref": "#/$defs/identityEvidence"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "completionMarker": {
          "type": "boolean"
        },
        "failureCode": {
          "type": "string",
          "pattern": "^migration\\.[a-z0-9._-]{1,119}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "postIdentity"
            ],
            "properties": {
              "completionMarker": {
                "const": true
              },
              "actionResults": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "completed"
                    }
                  }
                }
              }
            },
            "not": {
              "required": [
                "failureCode"
              ]
            }
          },
          "else": {
            "required": [
              "failureCode"
            ],
            "properties": {
              "completionMarker": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "safe-clone"
              },
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "policy",
              "status"
            ]
          },
          "then": {
            "properties": {
              "actionResults": {
                "minItems": 3,
                "maxItems": 4,
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "action": {
                          "const": "reset-machine-id"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "action": {
                          "const": "reset-ssh-host-keys"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "action": {
                          "const": "install-destination-ssh-keys"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mountBindings": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "mountBindings"
                  ]
                },
                "then": {
                  "properties": {
                    "actionResults": {
                      "prefixItems": [
                        {
                          "properties": {
                            "action": {
                              "const": "reset-machine-id"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "reset-ssh-host-keys"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "rebind-attached-disk-mounts"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "install-destination-ssh-keys"
                            }
                          }
                        }
                      ],
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                },
                "else": {
                  "properties": {
                    "actionResults": {
                      "prefixItems": [
                        {
                          "properties": {
                            "action": {
                              "const": "reset-machine-id"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "reset-ssh-host-keys"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "install-destination-ssh-keys"
                            }
                          }
                        }
                      ],
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "exact-guest-restore"
              },
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "policy",
              "status"
            ]
          },
          "then": {
            "properties": {
              "actionResults": {
                "minItems": 2,
                "maxItems": 3,
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "action": {
                          "const": "preserve-guest-identity"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "action": {
                          "const": "install-destination-ssh-keys"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mountBindings": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "mountBindings"
                  ]
                },
                "then": {
                  "properties": {
                    "actionResults": {
                      "prefixItems": [
                        {
                          "properties": {
                            "action": {
                              "const": "preserve-guest-identity"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "rebind-attached-disk-mounts"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "install-destination-ssh-keys"
                            }
                          }
                        }
                      ],
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                },
                "else": {
                  "properties": {
                    "actionResults": {
                      "prefixItems": [
                        {
                          "properties": {
                            "action": {
                              "const": "preserve-guest-identity"
                            }
                          }
                        },
                        {
                          "properties": {
                            "action": {
                              "const": "install-destination-ssh-keys"
                            }
                          }
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mountBindings": {
                "minItems": 1
              }
            },
            "required": [
              "mountBindings"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "actionResults": {
                  "contains": {
                    "properties": {
                      "action": {
                        "const": "rebind-attached-disk-mounts"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              }
            }
          },
          "else": {
            "properties": {
              "actionResults": {
                "not": {
                  "contains": {
                    "properties": {
                      "action": {
                        "const": "rebind-attached-disk-mounts"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
