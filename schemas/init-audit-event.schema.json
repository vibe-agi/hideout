{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/init-audit-event.schema.json",
  "title": "Hideout Init Audit Event",
  "type": "object",
  "required": [
    "version",
    "time",
    "operation",
    "profile",
    "backend",
    "network",
    "taskId",
    "taskKind",
    "source",
    "targetScope",
    "capabilityBoundary",
    "risk",
    "taskStatus",
    "result",
    "decision"
  ],
  "properties": {
    "version": {
      "const": "hideout.init-audit/v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "enum": [
        "init.apply",
        "run.init.apply",
        "doctor.fix.apply"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": [
        "native",
        "lima"
      ]
    },
    "network": {
      "enum": [
        "direct",
        "tun2socks"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "taskKind": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "targetScope": {
      "type": "string",
      "minLength": 1
    },
    "capabilityBoundary": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "minLength": 1
    },
    "taskStatus": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "applied",
        "skipped",
        "blocked",
        "error"
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "audit-only",
        "error"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
