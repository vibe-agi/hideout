{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/runtime-catalog.schema.json",
  "title": "Hideout Runtime Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalogRelease", "generatedAt", "families"],
  "properties": {
    "schema": {
      "const": "hideout.runtime-catalog/v1"
    },
    "catalogRelease": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "families": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/family"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "families": { "maxItems": 0 }
        },
        "required": ["families"]
      },
      "then": {
        "properties": {
          "catalogRelease": { "const": "development-unpromoted" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "maturity", "currentRevision", "revisions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "maturity": {
          "const": "preview"
        },
        "currentRevision": {
          "$ref": "#/$defs/id"
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/revision"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "contractId", "contractDigest", "reviewedAt", "artifacts"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["preview", "withdrawn"]
        },
        "contractId": {
          "$ref": "#/$defs/id"
        },
        "contractDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostOS",
        "hostArch",
        "guestArch",
        "format",
        "location",
        "sha256",
        "downloadBytes",
        "virtualBytes",
        "supplyMode",
        "source",
        "packageInventoryDigest",
        "sbom"
      ],
      "properties": {
        "hostOS": {
          "enum": ["darwin", "linux"]
        },
        "hostArch": {
          "enum": ["arm64", "amd64"]
        },
        "guestArch": {
          "enum": ["aarch64", "x86_64"]
        },
        "format": {
          "const": "qcow2"
        },
        "location": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^@\\s?#]+\\.qcow2$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "downloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "virtualBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "supplyMode": {
          "const": "hideout-built"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "packageInventoryDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sbom": {
          "$ref": "#/$defs/sbom"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseLocation", "baseSHA512", "baseSHA256", "buildCommit", "sourceLockSHA256", "licenseReview"],
      "properties": {
        "baseLocation": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^@\\s?#]+\\.qcow2$"
        },
        "baseSHA512": {
          "$ref": "#/$defs/sha512"
        },
        "baseSHA256": {
          "$ref": "#/$defs/sha256"
        },
        "buildCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{12,40}$"
        },
        "sourceLockSHA256": {
          "$ref": "#/$defs/sha256"
        },
        "licenseReview": {
          "enum": ["reviewed", "pending"]
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "status"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "status": {
          "enum": ["available", "unavailable-preview"]
        },
        "format": {
          "enum": ["spdx-json", "cyclonedx-json"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference": {
          "type": "string",
          "format": "uri"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": ["available"]
          },
          "then": {
            "required": ["format", "sha256", "reference"]
          }
        }
      ]
    }
  }
}
