{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/projection-readiness.schema.json",
  "title": "Hideout Projection Readiness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "environmentId",
    "sessionSnapshotId",
    "catalogDigest",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "hideout.projection-readiness/v1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sessionSnapshotId": {
      "$ref": "#/$defs/digest"
    },
    "catalogDigest": {
      "$ref": "#/$defs/digest"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 129,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "relativePath", "sha256", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\\x00\\r\\n]+$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\\x00\\r\\n]+$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": ["dispatcher", "command"]
        }
      }
    }
  }
}
