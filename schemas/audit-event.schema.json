{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/audit-event.schema.json",
  "title": "Hideout Audit Event",
  "type": "object",
  "required": ["time", "session", "profile", "backend", "action", "decision"],
  "properties": {
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": ["native", "lima"]
    },
    "action": {
      "enum": [
        "backend.selected",
        "backend.cleanup",
        "workspace.mapping",
        "env.policy",
        "hostfs.policy",
        "command.start",
        "network.setup",
        "guest.privilege.status",
        "hideout.privileged_setup",
        "hideout.privileged_cleanup",
        "target.root_attempt",
        "session.start",
        "session.end",
        "session.cleanup",
        "broker.request",
        "host.open",
        "host.fs.stat",
        "host.fs.read",
        "host.fs.list",
        "host.fs.write",
        "host.fs.write.create",
        "host.fs.write.replace",
        "host.fs.write.append",
        "host.fs.write.truncate",
        "host.fs.write.mkdir",
        "host.fs.write.delete",
        "host.fs.write.rename",
        "host.fs.write.chmod",
        "host.fs.write.chown",
        "host.fs.overlay.stage",
        "host.fs.overlay.deny",
        "host.fs.overlay.pending",
        "host.fs.overlay.claim",
        "host.fs.overlay.apply",
        "host.fs.overlay.discard",
        "host.fs.overlay.timeout",
        "host.fs.overlay.conflict",
        "host.fs.overlay.cleanup",
        "portbridge.host-to-guest",
        "endpoint.expose.host-to-guest",
        "preview.open",
        "evidence.export",
        "portbridge.probe",
        "browser.control.probe",
        "preview.open.probe"
      ]
    },
    "decision": {
      "enum": ["allow", "deny", "ask", "audit-only", "error"]
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
