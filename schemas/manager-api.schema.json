{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/manager-api.schema.json",
  "title": "Hideout Manager API Response",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "const": "hideout.manager-api/v1"
    },
    "resource": {
      "enum": [
        "overview",
        "profiles",
        "sessions",
        "environments",
        "backends",
        "capabilities",
        "broker",
        "network",
        "secrets",
        "secret/plan",
        "secret/apply",
        "activity/summary",
        "activity/events",
        "activity/executions",
        "activity/coverage",
        "activity/risks",
        "activity/export/plan",
        "activity/export/apply",
        "audit/events",
        "audit",
        "settings",
        "init",
        "bundles",
        "projects",
        "init/plan",
        "init/apply",
        "run/plan",
        "run/apply",
        "run/status",
        "environment/stop/plan",
        "environment/stop/apply",
        "environment/clean/plan",
        "environment/clean/apply",
        "environment/delete/plan",
        "environment/delete/apply",
        "profile/command-proxy/plan",
        "profile/command-proxy/apply",
        "profile/hostfs/plan",
        "profile/hostfs/apply",
        "profile/env/plan",
        "profile/env/apply",
        "profile/network/plan",
        "profile/network/apply",
        "profile/transaction/plan",
        "profile/transaction/apply",
        "evidence/export/plan",
        "evidence/export/apply",
        "hostfs/write/plan",
        "hostfs/write/claim",
        "hostfs/write/apply",
        "hostfs/write/discard",
        "hostfs/write/status",
        "decisions",
        "decision/inspect",
        "decision/claim",
        "decision/release",
        "decision/approve",
        "decision/deny",
        "decision/reopen",
        "decision/revoke",
        "decision/status",
        "notices",
        "notice/inspect",
        "notice/ack",
        "adapter-packs",
        "adapter-pack/inspect",
        "adapter-pack/plan",
        "adapter-pack/apply",
        "app/list",
        "app/inspect",
        "app/plan",
        "app/apply",
        "runtime/catalog",
        "runtime/status",
        "runtime/verify/plan",
        "runtime/verify/apply",
        "operator/snapshot",
        "operation/inspect",
        "profile/projection",
        "migration/capabilities",
        "migration/secret-input",
        "migration/export/plan",
        "migration/export/apply",
        "migration/import/inspect",
        "migration/import/plan",
        "migration/import/apply",
        "migration/operations",
        "migration/operation",
        "migration/operation/resume",
        "migration/operation/cancel",
        "migration/operation/recover"
      ]
    },
    "data": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errorDetails": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          },
          "field": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "recovery": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["version", "resource", "data"]
    },
    {
      "required": ["version", "errors"],
      "not": {
        "required": ["data"]
      }
    }
  ],
  "additionalProperties": false
}
