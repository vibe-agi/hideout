{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/run-result.schema.json",
  "title": "Hideout Run Result",
  "type": "object",
  "required": [
    "version",
    "sessionId",
    "profile",
    "backend",
    "command"
  ],
  "properties": {
    "version": {
      "const": "hideout.run-result/v1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": ["native", "lima"]
    },
    "environmentId": {
      "type": "string",
      "minLength": 1
    },
    "instanceName": {
      "type": "string",
      "minLength": 1
    },
    "preserveInstance": {
      "type": "boolean"
    },
    "auditPath": {
      "type": "string",
      "minLength": 1
    },
    "boundarySummary": {
      "type": "object",
      "required": ["version", "evidence", "capabilities"],
      "properties": {
        "version": {
          "const": "hideout.boundary-summary/v1"
        },
        "evidence": {
          "enum": ["available", "disabled", "unavailable"]
        },
        "auditPath": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "allowed", "denied"],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "lifetime": {
                "type": "string",
                "minLength": 1
              },
              "endpointCategory": {
                "type": "string",
                "minLength": 1
              },
              "allowed": {
                "type": "integer",
                "minimum": 0
              },
              "denied": {
                "type": "integer",
                "minimum": 0
              },
              "unsupported": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": "integer",
                "minimum": 0
              },
              "auditOnly": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "cleanupError": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
