{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/run-result.schema.json",
  "title": "Hideout Run Result",
  "type": "object",
  "required": [
    "version",
    "sessionId",
    "profile",
    "backend",
    "command"
  ],
  "properties": {
    "version": {
      "const": "hideout.run-result/v1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": ["native", "lima"]
    },
    "environmentId": {
      "type": "string",
      "minLength": 1
    },
    "environmentName": {
      "type": "string",
      "minLength": 1
    },
    "instanceName": {
      "type": "string",
      "minLength": 1
    },
    "preserveInstance": {
      "type": "boolean"
    },
    "environmentDisposition": {
      "enum": ["removed", "cleanup-required"]
    },
    "auditPath": {
      "type": "string",
      "minLength": 1
    },
    "boundarySummary": {
      "type": "object",
      "required": ["version", "evidence", "capabilities"],
      "properties": {
        "version": {
          "const": "hideout.boundary-summary/v1"
        },
        "evidence": {
          "enum": ["available", "disabled", "unavailable"]
        },
        "auditPath": {
          "type": "string",
          "minLength": 1
        },
        "hostfsVisibility": {
          "type": "object",
          "required": [
            "posture",
            "discoverGrants",
            "discoverDeny",
            "maxListEntries",
            "maxDepth",
            "nonClaim"
          ],
          "properties": {
            "posture": {
              "type": "string",
              "minLength": 1
            },
            "discoverGrants": {
              "type": "integer",
              "minimum": 0
            },
            "discoverDeny": {
              "type": "integer",
              "minimum": 0
            },
            "maxListEntries": {
              "type": "integer",
              "minimum": 1
            },
            "maxDepth": {
              "type": "integer",
              "minimum": 1
            },
            "nonClaim": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": [
            "family",
            "revision",
            "status",
            "contractDigest",
            "artifactDigest",
            "privilegeStatus",
            "failedCount"
          ],
          "properties": {
            "family": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "status": {"type": "string", "minLength": 1},
            "contractDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "privilegeStatus": {"enum": ["enforced", "degraded", "unknown"]},
            "failedCount": {"type": "integer", "minimum": 0},
            "recoveryCode": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "allowed", "denied"],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "lifetime": {
                "type": "string",
                "minLength": 1
              },
              "closeReason": {
                "type": "string",
                "minLength": 1
              },
              "endpointCategory": {
                "type": "string",
                "minLength": 1
              },
              "allowed": {
                "type": "integer",
                "minimum": 0
              },
              "denied": {
                "type": "integer",
                "minimum": 0
              },
              "unsupported": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": "integer",
                "minimum": 0
              },
              "auditOnly": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "cleanupError": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
