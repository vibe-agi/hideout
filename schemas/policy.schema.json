{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/policy.schema.json",
  "title": "Hideout Capability Proposal",
  "description": "Canonical policy decision object returned by builtin policy and constrained goja hooks.",
  "type": "object",
  "required": ["decision", "route", "action", "resources", "reason"],
  "properties": {
    "decision": {
      "enum": ["allow", "deny", "ask", "audit-only"]
    },
    "route": {
      "enum": ["guest-direct", "guest-exec", "host-broker", "fake", "deny"]
    },
    "action": {
      "enum": ["host.open", "guest.exec", "network.connect"]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "anyOf": [
            {
              "pattern": "[tT][oO][kK][eE][nN]="
            },
            {
              "pattern": "[pP][aA][sS][sS][wW][oO][rR][dD]="
            },
            {
              "pattern": "[pP][aA][sS][sS][wW][dD]="
            },
            {
              "pattern": "[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]="
            },
            {
              "pattern": "[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]="
            },
            {
              "pattern": "[cC][oO][oO][kK][iI][eE]="
            },
            {
              "pattern": "[pP][rR][iI][vV][aA][tT][eE][_-]?[kK][eE][yY]="
            },
            {
              "pattern": "[aA][pP][iI][_-]?[kK][eE][yY]="
            },
            {
              "pattern": "[aA][cC][cC][eE][sS][sS][_-]?[kK][eE][yY]="
            },
            {
              "pattern": "[sS][eE][cC][rR][eE][tT]="
            },
            {
              "pattern": "[aA][uU][tT][hH]="
            },
            {
              "pattern": "[cC][oO][dD][eE]="
            },
            {
              "pattern": "[kK][eE][yY]="
            },
            {
              "pattern": "://[^/?#\\s]*@"
            }
          ]
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "host.open"
          },
          "decision": {
            "const": "allow"
          }
        },
        "required": ["action", "decision"]
      },
      "then": {
        "properties": {
          "route": {
            "const": "host-broker"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "host.open"
          },
          "decision": {
            "not": {
              "const": "deny"
            }
          }
        },
        "required": ["action", "decision"]
      },
      "then": {
        "properties": {
          "route": {
            "const": "host-broker"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "guest.exec"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "route": {
            "enum": ["guest-direct", "guest-exec", "deny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "network.connect"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "route": {
            "enum": ["guest-direct", "deny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "route": {
            "const": "deny"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
