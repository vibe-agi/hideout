{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/policy.schema.json",
  "title": "Hideout Capability Proposal",
  "description": "Canonical policy decision object returned by builtin policy and constrained goja hooks.",
  "type": "object",
  "required": ["decision", "route", "action", "resources", "reason"],
  "properties": {
    "decision": {
      "enum": ["allow", "deny", "ask", "audit-only"]
    },
    "route": {
      "enum": ["guest-direct", "guest-exec", "host-broker", "portbridge", "fake", "deny"]
    },
    "action": {
      "enum": ["host.open", "guest.exec", "network.connect", "portbridge.host-to-guest", "endpoint.expose.host-to-guest"]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "anyOf": [
            {
              "pattern": "[Hh][Ii][Dd][Ee][Oo][Uu][Tt]_[Ss][Ee][Cc][Rr][Ee][Tt]_"
            },
            {
              "pattern": "\\b(cap|ui)_[0-9a-f]{16,}\\b"
            }
          ]
        },
        "$comment": "Deterministic guard: resources may carry raw user URLs and query values (host-local evidence, preserved verbatim); only Hideout-minted control-plane credentials (HIDEOUT_SECRET_* backing names, matched case-insensitively via character classes because ECMA-262 schema patterns have no inline flags, and cap_/ui_ token values) are rejected. Mirrors internal/audit and internal/policy resourceContainsControlPlaneSecret, including their (?i) case-insensitivity."
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "host.open"
          },
          "decision": {
            "const": "allow"
          }
        },
        "required": ["action", "decision"]
      },
      "then": {
        "properties": {
          "route": {
            "const": "host-broker"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "endpoint.expose.host-to-guest"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "route": {
            "enum": ["portbridge", "deny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "host.open"
          },
          "decision": {
            "not": {
              "const": "deny"
            }
          }
        },
        "required": ["action", "decision"]
      },
      "then": {
        "properties": {
          "route": {
            "const": "host-broker"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "guest.exec"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "route": {
            "enum": ["guest-direct", "guest-exec", "deny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "network.connect"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "route": {
            "enum": ["guest-direct", "deny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "portbridge.host-to-guest"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "route": {
            "enum": ["portbridge", "deny"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "route": {
            "const": "deny"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
