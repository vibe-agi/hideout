{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/package-manifest.schema.json",
  "title": "Hideout Package Manifest",
  "oneOf": [
    {
      "$ref": "#/$defs/artifactManifest"
    },
    {
      "$ref": "#/$defs/installStateManifest"
    }
  ],
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostOS", "hostArch", "linuxGuestArch"],
      "properties": {
        "hostOS": {
          "type": "string",
          "minLength": 1
        },
        "hostArch": {
          "type": "string",
          "minLength": 1
        },
        "linuxGuestArch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installStateSchema"],
      "properties": {
        "installStateSchema": {
          "const": "hideout.package-install-state.v1"
        },
        "fromInstalledSchemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumPackageSchema": {
          "type": "string"
        },
        "maximumPackageSchema": {
          "type": "string"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "executable"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "kind": {
          "enum": [
            "binary",
            "linux-helper",
            "helper-manifest",
            "installer",
            "entrypoint",
            "schema",
            "doc",
            "script",
            "packaging"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "artifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "builtAt", "git", "target", "layout", "files", "migration"],
      "properties": {
        "schema": {
          "const": "hideout.package-manifest.v1"
        },
        "builtAt": {
          "type": "string",
          "format": "date-time"
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "binaries", "entrypoints", "directories"],
          "properties": {
            "root": {
              "const": "hideout"
            },
            "binaries": {
              "type": "array",
              "minItems": 4,
              "items": {
                "$ref": "#/$defs/safeRelativePath"
              },
              "contains": {
                "const": "bin/hideout"
              }
            },
            "entrypoints": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/safeRelativePath"
              },
              "allOf": [
                {
                  "contains": {
                    "const": "install.sh"
                  }
                },
                {
                  "contains": {
                    "const": "README.md"
                  }
                }
              ]
            },
            "directories": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/safeRelativePath"
              },
              "contains": {
                "const": "schemas"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/file"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "const": "bin/hideout"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["path", "kind"],
                "properties": {
                  "path": {
                    "const": "install.sh"
                  },
                  "kind": {
                    "const": "installer"
                  }
                }
              }
            }
          ]
        },
        "migration": {
          "$ref": "#/$defs/migration"
        }
      }
    },
    "installStateManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "installedAt",
        "installPrefix",
        "storeRoot",
        "package",
        "files",
        "directories",
        "migration"
      ],
      "properties": {
        "schema": {
          "const": "hideout.package-install-state.v1"
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "installPrefix": {
          "type": "string",
          "minLength": 1
        },
        "storeRoot": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "builtAt", "git", "target"],
          "properties": {
            "schema": {
              "const": "hideout.package-manifest.v1"
            },
            "builtAt": {
              "type": "string",
              "format": "date-time"
            },
            "git": {
              "$ref": "#/$defs/git"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safeRelativePath"
          }
        },
        "migration": {
          "$ref": "#/$defs/migration"
        }
      }
    }
  }
}
