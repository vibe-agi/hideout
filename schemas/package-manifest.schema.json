{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/package-manifest.schema.json",
  "title": "Hideout Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "builtAt", "git", "target", "layout", "files"],
  "properties": {
    "schema": {
      "const": "hideout.package-manifest.v1"
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostOS", "hostArch", "linuxGuestArch"],
      "properties": {
        "hostOS": {
          "type": "string",
          "minLength": 1
        },
        "hostArch": {
          "type": "string",
          "minLength": 1
        },
        "linuxGuestArch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "binaries", "entrypoints", "directories"],
      "properties": {
        "root": {
          "const": "hideout"
        },
        "binaries": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "contains": {
            "const": "bin/hideout"
          }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "contains": {
            "const": "README.md"
          }
        },
        "directories": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "contains": {
            "const": "schemas"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "kind": {
            "enum": [
              "binary",
              "linux-helper",
              "helper-manifest",
              "entrypoint",
              "schema"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "const": "bin/hideout"
          }
        }
      }
    }
  }
}
