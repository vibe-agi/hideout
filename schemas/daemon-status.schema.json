{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/daemon-status.schema.json",
  "title": "Hideout daemon status",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "buildId", "state", "transport"],
  "properties": {
    "version": {
      "const": "hideout.daemon-status/v1"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": ["starting", "serving", "stopping", "stopped"]
    },
    "instanceId": {
      "type": "string",
      "pattern": "^daemon_[a-f0-9]{24}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["socket", "sessionSocket", "sessionProtocol"],
      "properties": {
        "socket": {
          "type": "string",
          "minLength": 1
        },
        "sessionSocket": {
          "type": "string",
          "minLength": 1
        },
        "sessionProtocol": {
          "const": "hideout.session/v1"
        }
      }
    },
    "credentialGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "sessions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "active-session-summary.schema.json"
      }
    },
    "background": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "op", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "status": {
            "enum": ["queued", "running", "completed", "failed"]
          }
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "lifecycle-status.schema.json"
      }
    }
  }
}
