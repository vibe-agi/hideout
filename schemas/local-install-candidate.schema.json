{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/local-install-candidate.schema.json",
  "title": "Hideout exact local candidate installation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "result",
    "sourceCandidate",
    "candidateAcceptance",
    "candidate",
    "installation",
    "checks",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "hideout.local-install-candidate/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "const": "passed"
    },
    "sourceCandidate": {
      "$ref": "#/$defs/sourceCandidate"
    },
    "candidateAcceptance": {
      "const": true
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "archive",
        "archiveSHA256",
        "packageManifestSHA256",
        "installedBinarySHA256",
        "consumedWithoutRebuild"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "archive": {
          "$ref": "#/$defs/safePath"
        },
        "archiveSHA256": {
          "$ref": "#/$defs/sha256"
        },
        "packageManifestSHA256": {
          "$ref": "#/$defs/sha256"
        },
        "installedBinarySHA256": {
          "$ref": "#/$defs/sha256"
        },
        "consumedWithoutRebuild": {
          "const": true
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostOS",
        "hostArch",
        "prefix",
        "store",
        "legacyDataPolicy",
        "priorInstallation",
        "finalInstallation",
        "finalDaemonState",
        "finalEnvironmentCount"
      ],
      "properties": {
        "hostOS": {
          "const": "Darwin"
        },
        "hostArch": {
          "const": "arm64"
        },
        "prefix": {
          "type": "string",
          "minLength": 2
        },
        "store": {
          "type": "string",
          "minLength": 2
        },
        "legacyDataPolicy": {
          "const": "explicitly-discarded"
        },
        "priorInstallation": {
          "type": "string",
          "minLength": 1
        },
        "finalInstallation": {
          "const": "exact-standalone-candidate"
        },
        "finalDaemonState": {
          "const": "stopped"
        },
        "finalEnvironmentCount": {
          "const": 0
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceClean",
        "archiveDigestVerified",
        "archiveSafetyVerified",
        "packageVerified",
        "packageIdentityVerified",
        "legacyInstallRemoved",
        "legacyDataDiscarded",
        "unrelatedHomebrewPreserved",
        "setupCompleted",
        "daemonStarted",
        "secretStoredWithoutRetention",
        "connectionPlanned",
        "connectionAppliedWithoutDaemonStop",
        "runCompletedThroughProxy",
        "helpJourneysRendered",
        "tuiSnapshotRendered",
        "tuiPTYExitedCleanly",
        "webUIAuthenticated",
        "environmentCleaned",
        "sameCandidateUpdate",
        "uninstallDryRun",
        "uninstallPreservedStore",
        "packageFilesAbsentAfterUninstall",
        "finalReinstallExact",
        "finalDaemonStopped",
        "finalEnvironmentAbsent",
        "noSecretValueInEvidence"
      ],
      "properties": {
        "sourceClean": {
          "const": true
        },
        "archiveDigestVerified": {
          "const": true
        },
        "archiveSafetyVerified": {
          "const": true
        },
        "packageVerified": {
          "const": true
        },
        "packageIdentityVerified": {
          "const": true
        },
        "legacyInstallRemoved": {
          "const": true
        },
        "legacyDataDiscarded": {
          "const": true
        },
        "unrelatedHomebrewPreserved": {
          "const": true
        },
        "setupCompleted": {
          "const": true
        },
        "daemonStarted": {
          "const": true
        },
        "secretStoredWithoutRetention": {
          "const": true
        },
        "connectionPlanned": {
          "const": true
        },
        "connectionAppliedWithoutDaemonStop": {
          "const": true
        },
        "runCompletedThroughProxy": {
          "const": true
        },
        "helpJourneysRendered": {
          "const": true
        },
        "tuiSnapshotRendered": {
          "const": true
        },
        "tuiPTYExitedCleanly": {
          "const": true
        },
        "webUIAuthenticated": {
          "const": true
        },
        "environmentCleaned": {
          "const": true
        },
        "sameCandidateUpdate": {
          "const": true
        },
        "uninstallDryRun": {
          "const": true
        },
        "uninstallPreservedStore": {
          "const": true
        },
        "packageFilesAbsentAfterUninstall": {
          "const": true
        },
        "finalReinstallExact": {
          "const": true
        },
        "finalDaemonStopped": {
          "const": true
        },
        "finalEnvironmentAbsent": {
          "const": true
        },
        "noSecretValueInEvidence": {
          "const": true
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
    },
    "sourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "dirty"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "tree": {
          "$ref": "#/$defs/gitObject"
        },
        "dirty": {
          "const": false
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "const": "0600"
        }
      }
    }
  }
}
