{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/daemon-event.schema.json",
  "title": "Hideout daemon live event",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "seq"],
  "properties": {
    "version": {
      "const": "hideout.daemon-event/v1"
    },
    "kind": {
      "enum": ["environment", "session", "workspace-view", "background", "audit", "export", "cleanup", "hostfs-write", "decision", "notice", "lifecycle", "terminal"]
    },
    "phase": {
      "enum": ["start", "progress", "complete", "failed"]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["environment", "session", "workspace-view", "run", "background", "audit", "export", "cleanup", "hostfs-write", "decision", "notice", "lifecycle", "stream"]
        },
        "id": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "autoNamed": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "guestWorkspace": {
          "type": "string"
        },
        "imageRef": {
          "type": "string"
        },
        "instanceName": {
          "type": "string"
        },
        "lastSessionId": {
          "type": "string"
        },
        "lastCommand": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastStartedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastEndedAt": {
          "type": "string",
          "format": "date-time"
        },
        "networkMode": {
          "type": "string"
        },
        "hasAudit": {
          "type": "boolean"
        },
        "hasEphemeralState": {
          "type": "boolean"
        },
        "op": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "session": {
          "type": "string"
        },
        "attachmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^wrk_[a-f0-9]{64}$"
        },
        "workspaceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "workspaceTransport": {
          "const": "workspace-portal"
        },
        "workspaceViewState": {
          "enum": [
            "planned",
            "provider-starting",
            "provider-ready",
            "view-mounting",
            "ready",
            "draining",
            "released",
            "unproved"
          ]
        },
        "workspaceRelations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "selectedPosition", "workspaceId", "otherWorkspaceId"],
            "properties": {
              "relation": {"enum": ["same", "nested", "disjoint"]},
              "selectedPosition": {"enum": ["ancestor", "descendant", "peer"]},
              "workspaceId": {"type": "string", "pattern": "^wrk_[a-f0-9]{64}$"},
              "otherWorkspaceId": {"type": "string", "pattern": "^wrk_[a-f0-9]{64}$"}
            }
          }
        },
        "blockerCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "cleanupStatus": {
          "enum": ["absent", "unproved"]
        },
        "action": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "source": {
          "type": "string"
        },
        "artifactPath": {
          "type": "string"
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secretState": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "decisionId": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "destinationPath": {
          "type": "string"
        },
        "privilegeStatus": {
          "type": "string"
        },
        "noticeId": {
          "type": "string"
        },
        "recordKind": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "acknowledged": {
          "type": "boolean"
        },
        "defaultOutcome": {
          "type": "string"
        },
        "preview": {
          "type": "object"
        },
        "lifecycle": {
          "$ref": "lifecycle-status.schema.json"
        }
      }
    }
  },
  "allOf": [
    {
	  "if": {
	    "properties": {
	      "kind": {
	        "const": "lifecycle"
	      }
	    },
	    "required": ["kind"]
	  },
	  "then": {
	    "required": ["entity", "payload"],
	    "properties": {
	      "payload": {
	        "required": ["lifecycle"]
	      }
	    }
	  }
	},
	{
      "if": {
        "properties": {
          "kind": {
            "const": "environment"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["id"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["id"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workspace-view"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": [
              "attachmentId",
              "session",
              "environmentId",
              "workspaceId",
              "workspaceLabel",
              "guestWorkspace",
              "workspaceTransport",
              "workspaceViewState"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "background"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["id", "op", "status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audit"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["action", "decision"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "export"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cleanup"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hostfs-write"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["decisionId", "operationId", "status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["decisionId", "recordKind", "status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "notice"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["entity", "payload"],
        "properties": {
          "payload": {
            "required": ["noticeId", "recordKind", "status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "terminal"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "required": ["reason"]
          }
        }
      }
    }
  ]
}
