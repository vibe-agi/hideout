{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/release-readiness.schema.json",
  "title": "Hideout Release Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "mode",
    "evidenceClass",
    "releaseReady",
    "status",
    "sourceCommit",
    "platform",
    "matrix",
    "commands",
    "gates",
    "nonClaims",
    "redaction"
  ],
  "properties": {
    "schema": {
      "const": "hideout.release-readiness/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": ["local-fast", "release-candidate"]
    },
    "evidenceClass": {
      "enum": ["local-fast", "real-gate"]
    },
    "releaseReady": {
      "type": "boolean"
    },
    "status": {
      "enum": ["passed", "failed", "not-release"]
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "productVersion", "sourceCommit", "artifactSHA256", "hostOS", "hostArch"],
      "properties": {
        "name": {"const": "hideout"},
        "productVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+$"},
        "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "artifactSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "hostOS": {"type": "string", "minLength": 1},
        "hostArch": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "revision", "artifactSHA256", "hostOS", "hostArch", "guestArch", "buildCommit", "requireClean"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifactSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "hostOS": {"type": "string", "minLength": 1},
        "hostArch": {"type": "string", "minLength": 1},
        "guestArch": {"type": "string", "minLength": 1},
        "buildCommit": {"type": "string", "pattern": "^[a-f0-9]{12,40}$"},
        "requireClean": {"const": true}
      }
    },
    "candidateStatus": {"enum": ["passed", "failed"]},
    "signingObservationSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "notarizationObservationSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version"],
      "properties": {
        "schema": { "const": "hideout.support-matrix/v1" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "summary"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped", "not-run"] },
          "code": { "type": "string" },
          "reason": { "type": "string" },
          "hint": { "type": "string" },
          "nextActions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["passed", "failed", "missing", "skipped", "not-run"] },
          "code": { "type": "string" },
          "reason": { "type": "string" },
          "hint": { "type": "string" },
          "nextActions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidencePath": { "type": "string", "minLength": 1 },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema", "family", "revision", "artifactSHA256", "environmentId",
              "hostOS", "hostArch", "guestArch", "buildCommit", "buildDirty"
            ],
            "properties": {
              "schema": {"const": "hideout.runtime-evidence-binding/v1"},
              "family": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "artifactSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "environmentId": {"type": "string", "pattern": "^env_[a-z0-9]+$"},
              "hostOS": {"type": "string", "minLength": 1},
              "hostArch": {"type": "string", "minLength": 1},
              "guestArch": {"type": "string", "minLength": 1},
              "buildCommit": {"type": "string", "minLength": 1},
              "buildDirty": {"type": "boolean"}
            }
          },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "control-plane"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["mode"],
        "properties": {"mode": {"const": "release-candidate"}}
      },
      "then": {"required": ["candidateStatus"]}
    },
    {
      "if": {
        "required": ["releaseReady"],
        "properties": {
          "releaseReady": {"const": true}
        }
      },
      "then": {
        "required": [
          "package",
          "runtime",
          "candidateStatus",
          "signingObservationSHA256",
          "notarizationObservationSHA256"
        ],
        "properties": {
          "mode": {"const": "release-candidate"},
          "evidenceClass": {"const": "real-gate"},
          "status": {"const": "passed"},
          "sourceCommit": {"pattern": "^[a-f0-9]{40}$"},
          "candidateStatus": {"const": "passed"},
          "commands": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["name", "status", "summary"],
                  "properties": {
                    "name": {"const": "local-checks"},
                    "status": {"const": "passed"},
                    "summary": {"type": "string", "minLength": 1}
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["name", "status", "summary"],
                  "properties": {
                    "name": {"const": "product-hardening-evidence"},
                    "status": {"const": "passed"},
                    "summary": {"type": "string", "minLength": 1}
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "gates": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["id", "required", "status", "evidencePath", "runtime", "summary"],
                  "properties": {
                    "id": {"const": "gate2-lima"},
                    "required": {"const": true},
                    "status": {"const": "passed"},
                    "evidencePath": {"type": "string", "minLength": 1},
                    "runtime": {
                      "type": "object",
                      "required": ["buildCommit", "buildDirty"],
                      "properties": {
                        "buildCommit": {"pattern": "^[a-f0-9]{12,40}$"},
                        "buildDirty": {"const": false}
                      }
                    },
                    "summary": {"type": "string", "minLength": 1}
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["id", "required", "status", "evidencePath", "runtime", "summary"],
                  "properties": {
                    "id": {"const": "gate3-hidden-proxy"},
                    "required": {"const": true},
                    "status": {"const": "passed"},
                    "evidencePath": {"type": "string", "minLength": 1},
                    "runtime": {
                      "type": "object",
                      "required": ["buildCommit", "buildDirty"],
                      "properties": {
                        "buildCommit": {"pattern": "^[a-f0-9]{12,40}$"},
                        "buildDirty": {"const": false}
                      }
                    },
                    "summary": {"type": "string", "minLength": 1}
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    }
  ]
}
