{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hideout.local/schemas/operation.schema.json",
  "title": "Hideout idempotent operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "owner",
    "planDigest",
    "phase",
    "effects",
    "recovery",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": { "const": "hideout.operation.v1" },
    "id": {
      "type": "string",
      "pattern": "^op_[A-Za-z0-9_-]{8,124}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["profile", "environment", "session", "secret"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "planned",
        "claimed",
        "staging",
        "activating",
        "proving",
        "rolling-back",
        "succeeded",
        "failed",
        "cancelled",
        "rolled-back",
        "rollback-unproved",
        "recovery-required"
      ]
    },
    "effects": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "provider", "phase"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "persist",
              "stage",
              "activate",
              "drain",
              "restart",
              "cleanup",
              "prove"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "phase": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "rolled-back",
              "unproved"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code"],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "value": {
                  "type": "string",
                  "maxLength": 1024
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "rolled-back",
            "unproved"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "summary": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "nextAction": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
